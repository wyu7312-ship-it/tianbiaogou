{
  "manifest_version": 3,
  "name": "填表狗",
  "version": "0.4.0",
  "description": "点输入框弹出你存过的值，点一下填进这一个框。数据只存本机，代码不联网。",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["data.js", "concepts.js", "matcher.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
