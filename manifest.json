{
  "manifest_version": 3,
  "name": "网申填充助手",
  "version": "0.3.0",
  "description": "点击输入框弹出已存信息，点选填入当前框；数据仅存本地，不联网。",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["data.js", "concepts.js", "matcher.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
